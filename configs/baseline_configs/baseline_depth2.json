{
  "experiment": {
    "name": "baseline_depth2"  
  },

  "data": {
    "test_size": 0.2,               
    "random_state": 42,             
    "use_feature": "original",           

    
    "training_noise_config": {
        "ratio": 0.0
      },

    "test_shift_config": {
     
      "contrast": {
        "factor_range": [0.7, 1.3]
      }
    }

  },

  "monitor": {
    "use_monitor": true,            
    "is_data_noisy": false,          
    "checkpoint_interval": 50      
  },

  "model": {
    "estimator": {
      "max_depth": 2,               
      "criterion": "entropy",       
      "max_features": 0.25,         
      "random_state": 42
    },
    "n_estimators": 500,            
    "learning_rate": 0.5,           
    "random_state": 42              
  }
}
