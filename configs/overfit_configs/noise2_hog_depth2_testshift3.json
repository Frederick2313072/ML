{
  "experiment": {
    "name": "noise2_hog_depth2_testshift3"  
  },

  "data": {
    "test_size": 0.2,               
    "random_state": 42,             
    "use_feature": "hog",           

    "feature_config":{
      
      "hog_params": {
        "orientations": 9,
        "pixels_per_cell": [2, 2],
        "cells_per_block": [2, 2]
      }

      
    },

    
    "training_noise_config": {
        "ratio": 0.2  ,
        "label_flip": true,               
        "gaussian": {"std": 0.05}               
             
      },

    "test_shift_config": {

      "multiple_disturbances_test": {
        "contrast": {
          "factor_range": [0.5, 1.5]
        },
        "rotate": {
          "angle_range": 15
        },
        "brightness": {
          "shift_range": 0.3
        }
      }
    }

  },

  "monitor": {
    "use_monitor": true,            
    "is_data_noisy": true,          
    "checkpoint_interval": 50      
  },

  "model": {
    "estimator": {
      "max_depth": 2,               
      "criterion": "entropy",       
      "max_features": 0.25,         
      "random_state": 42
    },
    "n_estimators": 500,            
    "learning_rate": 0.5,           
    "random_state": 42              
  }
}
